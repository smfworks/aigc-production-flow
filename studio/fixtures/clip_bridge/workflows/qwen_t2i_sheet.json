{
  "_clip_bridge": {
    "id": "qwen_t2i_sheet",
    "step": "Q1",
    "purpose": "Character sheet from story_lock. Inject prompt/negative/seed/size before POST /prompt.",
    "inject": [
      "10.inputs.prompt",
      "10.inputs.negative_prompt",
      "12.inputs.width",
      "12.inputs.height",
      "20.inputs.filename_prefix",
      "30.inputs.seed"
    ]
  },
  "4": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "5": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "6": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    }
  },
  "10": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": ["5", 0],
      "vae": ["6", 0],
      "prompt": "Photoreal character sheet of {identity}, {wardrobe}, three-quarter portrait plus a three-quarter back view, even studio key from camera-left, clean background, 16:9, native 2K. Identity plate for later reference. No text.",
      "negative_prompt": "no face morph, no extra people, no text, no logos, no watermark",
      "resolution": 1024
    }
  },
  "12": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 2560,
      "height": 1440,
      "batch_size": 1
    }
  },
  "30": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["10", 0],
      "negative": ["10", 1],
      "latent_image": ["12", 0],
      "seed": 42,
      "steps": 25,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    }
  },
  "31": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["30", 0],
      "vae": ["6", 0]
    }
  },
  "20": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["31", 0],
      "filename_prefix": "clipbridge/lock/character_sheet"
    }
  }
}
