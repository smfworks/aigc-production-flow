# Local-dev only. This is not SSO and not multi-tenant SaaS security.
STUDIO_API_TOKEN=local-dev-token
STUDIO_DEFAULT_USER=local-dev
STUDIO_DATABASE_URL=sqlite:///./data/studio.db
STUDIO_MEDIA_ROOT=./data/media
# Builder Open in Studio (Phase 8): CORS already allows localhost:5173.
# VITE_STUDIO_TOKEN on the builder must match STUDIO_API_TOKEN. Localhost defaults to the local-dev token.
# Job worker: thread (API in-process, default) | inline (tests) | off (HTTP only; run ./scripts/dev-studio.sh worker) | celery (opt-in Redis broker)
STUDIO_JOB_WORKER=thread
STUDIO_JOB_POLL_SECONDS=0.25
# Celery is opt-in. Empty = not configured. Never run thread + Celery against the same SQLite file.
STUDIO_CELERY_BROKER_URL=
# Generation is local only: stub receipts, or ComfyUI on loopback/private lanes. Studio does not call a cloud image or video API.
# Adapters: stub is the CI/default. webhook/cli/comfy-* fall back to stub if the hook is unset (not live).
# comfy-h3 declares measured hop-1 10.125s / 243f @ 24fps. comfy-qwen declares 1344x768. Not Hailuo/Veo/Kling.
STUDIO_STILL_ADAPTER=stub
STUDIO_CLIP_ADAPTER=stub
STUDIO_ADAPTER_WEBHOOK_URL=
STUDIO_ADAPTER_CLI=
STUDIO_ADAPTER_TIMEOUT_SECONDS=60
# Auth: local (default) | forward-header | oidc (opt-in JWKS). OIDC is off by default and is not a production IdP.
STUDIO_AUTH_MODE=local
# OIDC resource-server settings. Empty = not configured. No client secrets belong in git.
STUDIO_OIDC_ISSUER=
STUDIO_OIDC_AUDIENCE=
STUDIO_OIDC_CLIENT_ID=
STUDIO_OIDC_JWKS_URL=
STUDIO_OIDC_NAME_CLAIM=preferred_username
# Role claim map is unused unless STUDIO_OIDC_APPLY_ROLE_CLAIM is true. App roles stay authoritative.
STUDIO_OIDC_ROLE_CLAIM=
STUDIO_OIDC_ROLE_MAP=
STUDIO_OIDC_APPLY_ROLE_CLAIM=false
# Operator rate table. Opaque credits — not a cloud invoice.
STUDIO_COST_RATES=stub:0.1,webhook:1,cli:1,comfy-h3:2,comfy-qwen:0.5
STUDIO_COST_CURRENCY=credits
STUDIO_COST_USD_PER_UNIT=0
# Empty cap = unlimited. Hard stop 409s enqueue when spent+pending+new estimate exceeds cap.
STUDIO_BUDGET_CAP_UNITS=
STUDIO_BUDGET_HARD_STOP=false
# Expire stub job outputs / temp media after N days. 0 disables. Pack revisions are kept.
STUDIO_RETENTION_DAYS=30
# Media store. local (default, existing disk paths) | s3 (MinIO-compatible when endpoint+bucket are set).
# Unset / incomplete S3 config stays on local disk and never claims cloud storage is live.
STUDIO_MEDIA_BACKEND=local
STUDIO_S3_BUCKET=
STUDIO_S3_ENDPOINT=
STUDIO_S3_PREFIX=
STUDIO_S3_REGION=us-east-1
# S3 credentials belong in the process environment, not git. boto3 also reads the standard AWS chain.
# Presence chips TTL in seconds.
STUDIO_PRESENCE_TTL_SECONDS=60
# Optional outbound notification webhook. Empty = in-app only; never invents delivery.
STUDIO_NOTIFY_WEBHOOK_URL=
